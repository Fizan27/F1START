# Python environment and caches: rebuilt from requirements.txt, never committed.
.venv/
__pycache__/
.pytest_cache/

# Downloaded data: large, and anyone can rebuild it with the download scripts.
data/

# Website build output and installed packages: rebuilt by npm.
web/node_modules/
web/.next/
web/out/

# Editor and Claude Code local settings.
.vscode/
.claude/

# Secrets must never be committed to this public repo.
.env
*.key
